    {
      "name": "filter-tokens",
      "type": "registry:component",
      "title": "Filter Tokens (Radix UI)",
      "description": "Tokenized filter input component for shadcn projects using Radix UI primitives (default/legacy style). Renders the useFilterTokens() hook with tokens, dropdown, calendar, and locale-aware date/time inputs.",
      "author": "Francesco Carrella <francesco.carrella@gmail.com>",
      "categories": ["filter", "input", "tokens"],
      "dependencies": ["filter-tokens", "@radix-ui/react-popover", "lucide-react", "react-day-picker", "date-fns"],
      "registryDependencies": ["button", "calendar"],
